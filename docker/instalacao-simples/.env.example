# Copie este arquivo para ".env" e preencha os dois valores obrigatórios.
# O arquivo .env tem segredos: não o envie para o GitHub nem o compartilhe.

# Senha do banco de dados (inventada por você; só o servidor a usa)
POSTGRES_PASSWORD=

# Chave de administrador da API. É a "senha mestra": entra no painel e cria números.
# Gere uma com 64 caracteres:
#   Linux/Mac/Git Bash: openssl rand -hex 32
#   Windows PowerShell: -join ((48..57)+(97..102) | Get-Random -Count 64 | % {[char]$_})
GLOBAL_API_KEY=

# Opcional
# Porta no seu computador/servidor (padrão 4000)
# HTTP_PORT=4000
# Endereço em que a porta é aberta. O padrão (127.0.0.1) só atende este computador: quem
# acessa de fora é um proxy reverso com HTTPS. Para abrir para a rede, use 0.0.0.0.
# BIND_ADDRESS=127.0.0.1
# Limite de memória do contêiner, ex.: 1g (padrão 0 = sem limite). Com um limite o servidor ajusta o
# uso de memória do Go a 80 % dele (MEMORY_LIMIT_RATIO).
# MEM_LIMIT=0
# Versão da imagem (padrão: a mais recente). Para fixar uma versão: 0.7.2
# IMAGE_TAG=latest
