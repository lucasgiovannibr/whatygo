SERVER_PORT=8080

POSTGRES_AUTH_DB=postgresql://postgres:root@localhost:5432/whatygo_auth?sslmode=disable
POSTGRES_USERS_DB=postgresql://postgres:root@localhost:5432/whatygo_users?sslmode=disable
# Connection pool of each database (optional; these are the defaults)
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=10
# DB_CONN_MAX_LIFETIME_MIN=5
# DB_CONN_MAX_IDLE_MIN=1
DATABASE_SAVE_MESSAGES=false
CLIENT_NAME=whatygo

# Master key of the API. The server refuses to start with the values published in the examples.
# Generate one with: openssl rand -hex 32
GLOBAL_API_KEY=change-me

WADEBUG=INFO
LOGTYPE=console
WEBHOOK_FILES=true

CONNECT_ON_STARTUP=true
# Ask the phone to resend messages that fail to decrypt (default: false)
REREQUEST_FROM_PHONE=false
# Never fall back to a direct connection when the proxy fails (keeps the server IP hidden)
PROXY_FAIL_CLOSED=false

OS_NAME=WhatyGo

# Passkey (WebAuthn) pairing — required only for accounts that ask for a passkey
# when linking a device. Set this to the PUBLIC base URL of THIS API, reachable
# by the browser where WhatsApp Web opens (the WhatyGo Passkey Helper extension
# calls it from the web.whatsapp.com origin). Use a public domain in production,
# or a tunnel (ngrok/cloudflared) / LAN IP in development — NOT localhost if the
# browser runs on another machine. See docs/wiki/guias-api/passkey-pairing.md.
# PASSKEY_PUBLIC_URL=https://your-api.example.com

AMQP_URL=amqp://admin:admin@localhost:5672/default
AMQP_GLOBAL_ENABLED=false

# Global webhook that receives the events of every instance. Leave empty unless you own the receiver.
WEBHOOK_URL=
# Event payloads do not carry the instance token ("instanceToken"): it is the instance's API key and
# every consumer of the events could use it. Set to true only for an integration that still reads it.
# WEBHOOK_INCLUDE_TOKEN=true
# Keep the log directory of an instance after it is deleted (default: removed, it holds the token and JIDs).
# LOG_KEEP_DELETED=true

# Proxy Configuration
# PROXY_PROTOCOL can be http, https or socks5. If omitted, it is inferred from
# the port (1080/2080/42000-43000 → socks5; otherwise http).
# PROXY_PROTOCOL=http
# PROXY_HOST=proxy.example.com
# PROXY_PORT=8080
# PROXY_USERNAME=user
# PROXY_PASSWORD=secret

# Minio Configuration
MINIO_ENABLED=true
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=whatygo-media
MINIO_USE_SSL=false

# URLs supplied in requests (media, stickers, link previews, status) may only point to public
# addresses: private networks, loopback and the cloud metadata endpoint are refused (SSRF).
# Set to true only if you really fetch media from your own network; link-local and the
# metadata addresses stay blocked. Webhooks may always target the internal network.
# ALLOW_PRIVATE_URLS=true

# Media is stored under whatygo-medias/<instanceId>/ and served through presigned URLs
# (MINIO_URL_TTL_HOURS, default and maximum 168). The bucket policy is left alone; set this
# only if you want every object of the bucket to be world-readable (it replaces the policy).
# MINIO_PUBLIC_BUCKET=true
# MINIO_URL_TTL_HOURS=168

# ---- Optional tuning (these are the defaults; see docs/wiki/referencia/environment-variables.md) ----

# Minimum severity of the application logs: debug, info, warn, error
# LOG_LEVEL=info
# Browser origins allowed to call the API, comma separated (empty or * allows every origin)
# CORS_ORIGINS=https://app.example.com
# Request body limits in MB (routes that receive a file use the second one)
# MAX_BODY_MB=4
# MAX_MEDIA_BODY_MB=150
# Images that declare more megapixels than this are refused before decoding
# MAX_IMAGE_MEGAPIXELS=50
# ffmpeg / pdftoppm runs at once (default: max(2, CPUs/2))
# MAX_CONCURRENT_CONVERSIONS=2
# Start even with a published GLOBAL_API_KEY (local development only)
# ALLOW_INSECURE_API_KEY=true

# How long "this number is on WhatsApp" is remembered, in minutes (0 asks on every send)
# CHECK_USER_CACHE_TTL_MIN=720

# Sends of one instance inside the network call at once, and an optional sustained rate.
# A request that cannot get its turn within SEND_QUEUE_WAIT_SEC is answered 429 + Retry-After.
# SEND_MAX_CONCURRENT=4
# SEND_RATE_PER_MIN=0
# SEND_QUEUE_WAIT_SEC=30

# Received messages with media processed at once (whole process / per instance);
# MEDIA_ORDERED=true processes them inline, in arrival order.
# MEDIA_WORKERS=4
# MEDIA_WORKERS_PER_INSTANCE=2
# MEDIA_ORDERED=false

# Webhook delivery queue: per destination URL, and all destinations together
# WEBHOOK_QUEUE_MAX_EVENTS=1000
# WEBHOOK_QUEUE_MAX_MB=64
# WEBHOOK_QUEUE_GLOBAL_MB=256
# WEBHOOK_QUEUE_WORKERS=4

# Behind a reverse proxy: the proxies (IPs or CIDRs, comma separated) whose X-Forwarded-For is
# believed. Empty trusts no one (the client address is the connection's own), so a client cannot
# forge its address; without it every client behind the proxy shares the proxy's address.
# TRUSTED_PROXIES=172.18.0.0/16
# Failed authentications one client address may make per minute before it gets 429 (0 = off)
# AUTH_FAIL_LIMIT=30
# Shortest token POST /instance/create accepts (without a token one is generated)
# MIN_INSTANCE_TOKEN_LENGTH=16

# Media / link / status / webhook requests do not go through HTTP_PROXY / HTTPS_PROXY: through a
# proxy the check of the destination address cannot see the real one. true uses it anyway.
# OUTBOUND_PROXY_FROM_ENV=true
# false restricts webhooks to public addresses (default: they may target the internal network)
# WEBHOOK_ALLOW_PRIVATE=false

# With a container memory limit the Go soft memory limit is set to this share of it; GOMEMLIMIT,
# when set, wins; 0 turns it off.
# MEMORY_LIMIT_RATIO=0.8

# Received media is downloaded to a temporary file and refused above this size (MB): the
# sender decides how big a file is. The event is still published, without the file, with
# data.Message.mediaSkipped = "too_large". Needs a writable temp dir (TMPDIR, /tmp in the image).
# MAX_RECEIVED_MEDIA_MB=50

# One instance started every STARTUP_STAGGER_MS at boot; automatic reconnections back off from
# RECONNECT_BACKOFF_BASE_SEC doubling up to RECONNECT_BACKOFF_MAX_SEC.
# STARTUP_STAGGER_MS=300
# RECONNECT_BACKOFF_BASE_SEC=5
# RECONNECT_BACKOFF_MAX_SEC=300

# One replica runs each instance (Postgres advisory locks); false turns it off.
# INSTANCE_LOCK=true
